# Artefacts de compilation Rust : plusieurs centaines de Mo, regenerables.
target/

# Configurations d'editeur
.vscode/
.idea/

# Historique des releves : une base locale, pas du code.
history.csv

# Ce que le collecteur ecrit — releve courant, barres, niveaux. Quelques
# centaines de Ko par seance et par sous-jacent.
snapshots/

# Journaux du collecteur et du serveur : une trace locale, pas du code.
*.log

# Les copies laissees par une migration d'en-tete, et celles faites a la main
# avant d'y toucher. Meme raison que history.csv : ce sont des releves locaux,
# et les pousser mettrait dans un depot public ce que la ligne au-dessus en sort.
history.csv.*

# Rapports CFTC telecharges. Meme raison que snapshots/ : une donnee publique
# qu'un script rejoue en trente secondes n'a pas a vivre dans le depot, et les
# deux fichiers pesent un demi-mega-octet.
cftc/
